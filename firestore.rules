rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() ? myProfile().data.rol : '';
    }

    function isAdmin() {
      return signedIn()
             && myRole() == 'Admin'
             && myProfile().data.usuario == 'ADMIN1';
    }

    function isDirector() {
      return signedIn() && myRole() == 'Director';
    }

    function isNacional() {
      return signedIn() && myRole() == 'Nacional';
    }

    function isRegional() {
      return signedIn() && myRole() == 'Regional';
    }

    function isGerente() {
      return signedIn() && myRole() == 'Gerente';
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /cotizaciones/{cotizacionId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.distribuidor == myProfile().data.distribuidor
                    && request.resource.data.region == myProfile().data.region
                    && request.resource.data.tienda == myProfile().data.tienda;

      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isAdmin()
        || isDirector()
        || (
          isNacional()
          && resource.data.distribuidor == myProfile().data.distribuidor
        )
        || (
          isRegional()
          && resource.data.distribuidor == myProfile().data.distribuidor
          && resource.data.region == myProfile().data.region
        )
        || (
          isGerente()
          && resource.data.distribuidor == myProfile().data.distribuidor
          && resource.data.tienda == myProfile().data.tienda
        )
      );

      allow update, delete: if false;
    }

    match /reportes/{reporteId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
                  && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
